#!/usr/bin/env bash
set -euo pipefail

# ==========================================
# Cambio circular de colores - Home Assistant
# ==========================================

TOKEN_FILE="$HOME/.config/homeassistant-rice/token"
ENTITY="light.juanes"
URL="http://localhost:8123/api/services/light/turn_on"

# Guardar el último color entre pulsaciones.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/homeassistant-rice"
STATE_FILE="$STATE_DIR/color-index"
LOCK_FILE="$STATE_DIR/color.lock"

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

if [[ ! -r "$TOKEN_FILE" ]]; then
    echo "No se puede leer el token de Home Assistant" >&2
    exit 1
fi

# Evitar dos cambios simultáneos.
exec 9>"$LOCK_FILE"
flock -x 9

# Estado inicial: -1 para que el primer color sea blanco.
INDEX=-1

if [[ -f "$STATE_FILE" ]]; then
    read -r INDEX < "$STATE_FILE" || INDEX=-1
fi

if ! [[ "$INDEX" =~ ^-?[0-9]+$ ]] ||
   (( INDEX < -1 || INDEX > 4 )); then
    INDEX=-1
fi

NEXT=$(( (INDEX + 1) % 5 ))

# Perfiles RGB. Todos en formato compatible con
# el servicio light.turn_on de Home Assistant.
case "$NEXT" in
    0)
        NAME="Blanca de trabajo"
        RGB='[255,255,255]'
        BRIGHTNESS=100
        ;;
    1)
        NAME="Amarilla de descanso"
        RGB='[255,175,55]'
        BRIGHTNESS=60
        ;;
    2)
        NAME="Roja"
        RGB='[255,0,0]'
        BRIGHTNESS=70
        ;;
    3)
        NAME="Verde"
        RGB='[0,255,0]'
        BRIGHTNESS=70
        ;;
    4)
        NAME="Azul"
        RGB='[0,0,255]'
        BRIGHTNESS=70
        ;;
esac

# Construir el mensaje JSON.
PAYLOAD="$(
    jq -nc \
        --arg entity_id "$ENTITY" \
        --argjson rgb "$RGB" \
        --argjson brightness "$BRIGHTNESS" \
        '{
            entity_id: $entity_id,
            rgb_color: $rgb,
            brightness_pct: $brightness
        }'
)"

# Leer token privado sin mostrarlo en pantalla.
IFS= read -r TOKEN < "$TOKEN_FILE"

if [[ -z "$TOKEN" ]]; then
    echo "Token de Home Assistant vacío" >&2
    exit 1
fi

# Enviar el color a Home Assistant.
# Si falla la petición, no se avanza el contador.
printf 'header = "Authorization: Bearer %s"\n' "$TOKEN" |
    curl --config - \
        --silent --show-error --fail-with-body \
        --output /dev/null \
        --connect-timeout 3 \
        --max-time 10 \
        --request POST \
        --url "$URL" \
        --header "Content-Type: application/json" \
        --data "$PAYLOAD"

# Guardar el estado solo después de una petición exitosa.
printf '%s\n' "$NEXT" > "$STATE_FILE"

echo "Color aplicado: $NAME"
